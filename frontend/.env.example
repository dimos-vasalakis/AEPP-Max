NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase → Project Settings → API Keys: the publishable key (sb_publishable_…) or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the logo menu's "Κατέβασε την εφαρμογή" button points. Leave empty until there is a download.
NEXT_PUBLIC_DOWNLOAD_URL=
# Contact address on the privacy page (/privacy). GDPR expects one; the line is hidden while empty.
NEXT_PUBLIC_CONTACT_EMAIL=
