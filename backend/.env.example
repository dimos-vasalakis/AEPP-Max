ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Only needed for legacy projects using the HS256 JWT secret.
# Leave empty to verify tokens via the project's JWKS (asymmetric signing keys).
SUPABASE_JWT_SECRET=

# Postgres (Supabase → Connect). Paste the URIs as-is; the app swaps in the psycopg driver.
# App runtime: transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Alembic migrations: direct connection (port 5432). IPv6-only on Supabase unless you buy the
# IPv4 add-on; if it won't connect, use the session pooler URI (same host as above, port 5432).
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# OpenAI: the AI agent. Empty = /agent/chat returns 503 (the IDE still runs programs).
OPENAI_API_KEY=
# gpt-5.6-luna is the cheaper option.
OPENAI_MODEL=gpt-5.6-sol
